{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?project_ref=szzhvapmyokodyuxdqsj&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching",
      "enabled": true
    },
    "servers": {
      "browsermcp": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@browsermcp/mcp@latest"
        ]
      }
    }
  }
}