# DATABASE (Supabase Postgres)
# Connection string from the Supabase dashboard (Connect). Prefer the "Session pooler"
# URI: the direct db.<ref>.supabase.co host is IPv6-only unless the IPv4 add-on is enabled.
#   Session pooler: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   Direct:         postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# LLM PROVIDER (openai | ollama)
LLM_PROVIDER=openai

# OPENAI-COMPATIBLE LLM (e.g. Fireworks AI)
OPENAI_BASE_URL=https://api.fireworks.ai/inference/v1
OPENAI_API_KEY=your-fireworks-api-key
OPENAI_MODEL=accounts/fireworks/models/deepseek-v4p1-flash

# OLLAMA (optional local provider, only used when LLM_PROVIDER=ollama)
HOST_OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434

# BACKEND
HOST_BACKEND_PORT=8000

# FRONTEND
HOST_FRONTEND_PORT=3002
BACKEND_BASE_URL=http://localhost:8000
