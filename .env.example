# DATABASE (Supabase Postgres)
# Connection string from the Supabase dashboard (Connect). Prefer the "Session pooler"
# URI: the direct db.<ref>.supabase.co host is IPv6-only unless the IPv4 add-on is enabled.
#   Session pooler: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   Direct:         postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# SUPABASE (frontend auth)
# Public API URL and anon key from the Supabase dashboard (Project Settings > API).
# The frontend Supabase clients read these (Vite exposes only VITE_-prefixed vars).
#   Hosted: https://<ref>.supabase.co
#   Local:  the API URL and anon key printed by `supabase start` (http://localhost:54321)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_KEY=your-supabase-anon-key

# LLM PROVIDER (openai | ollama)
LLM_PROVIDER=openai

# OPENAI-COMPATIBLE LLM (e.g. Fireworks AI)
OPENAI_BASE_URL=https://api.fireworks.ai/inference/v1
OPENAI_API_KEY=your-fireworks-api-key
OPENAI_MODEL=accounts/fireworks/models/deepseek-v4p1-flash

# Optional: the models offered in the picker, comma-separated. Each entry is
# either `model-id` or `model-id=Display name`. Without an explicit name, a
# readable one is derived from the id (e.g. `deepseek-v4p1-flash` -> `Deepseek V4.1 Flash`).
# OPENAI_MODELS=accounts/fireworks/models/deepseek-v4p1-flash=DeepSeek V4.1 Flash,accounts/fireworks/models/llama-v3p1-8b-instruct=Llama 3.1 8B Instruct

# OLLAMA (optional local provider, only used when LLM_PROVIDER=ollama)
HOST_OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434

# BACKEND
HOST_BACKEND_PORT=8000

# RATE LIMITING (per user, across all their threads)
# A user may send RATE_LIMIT_MAX_MESSAGES chat messages within a rolling
# RATE_LIMIT_WINDOW_MINUTES window. Set either value to 0 to disable.
RATE_LIMIT_MAX_MESSAGES=20
RATE_LIMIT_WINDOW_MINUTES=5

# FRONTEND
HOST_FRONTEND_PORT=3002
BACKEND_BASE_URL=http://localhost:8000
